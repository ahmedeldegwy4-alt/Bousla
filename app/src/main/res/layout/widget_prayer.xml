<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="10dp"
    android:background="@drawable/widget_bg" android:layoutDirection="rtl">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:layout_width="34dp" android:layout_height="34dp" android:src="@drawable/ic_launcher"/>
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:paddingStart="6dp"
            android:text="مواقيت الصلاة" android:textColor="#D9B45A" android:textSize="17sp" android:textStyle="bold"/>
        <TextView android:id="@+id/p_date" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#C9D8D3" android:textSize="15sp" android:maxLines="1"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1.1"
        android:layout_marginTop="6dp" android:orientation="horizontal" android:gravity="center_vertical"
        android:background="@drawable/wp_next_bg" android:paddingStart="14dp" android:paddingEnd="14dp">
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="الصلاة الجاية"
                android:textColor="#0F2A23" android:textSize="15sp"/>
            <TextView android:id="@+id/p_next" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#0F2A23" android:textSize="32sp" android:textStyle="bold" android:maxLines="1" android:text="…"/>
        </LinearLayout>
        <ImageView android:layout_width="72dp" android:layout_height="72dp" android:src="@drawable/ic_launcher"
            android:layout_marginStart="6dp" android:layout_marginEnd="6dp" android:scaleType="fitCenter"/>
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="باقي"
                android:textColor="#0F2A23" android:textSize="15sp"/>
            <Chronometer android:id="@+id/p_count" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#0F2A23" android:textSize="34sp" android:textStyle="bold"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:layout_marginTop="6dp" android:orientation="horizontal">
        <LinearLayout android:id="@+id/p_c0" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
            android:orientation="vertical" android:gravity="center" android:layout_marginStart="2dp" android:layout_marginEnd="2dp" android:paddingTop="2dp" android:paddingBottom="4dp">
            <TextView android:id="@+id/p_l0" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#0F2A23" android:textSize="13sp" android:textStyle="bold" android:maxLines="1"/>
            <TextView android:id="@+id/p_n0" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#C9D8D3" android:textSize="19sp" android:maxLines="1"
                android:autoSizeTextType="uniform" android:autoSizeMinTextSize="13sp" android:autoSizeMaxTextSize="21sp"/>
            <TextView android:id="@+id/p_t0" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#EEF3EF" android:textSize="21sp" android:textStyle="bold" android:maxLines="1"
                android:autoSizeTextType="uniform" android:autoSizeMinTextSize="14sp" android:autoSizeMaxTextSize="23sp"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/p_c1" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
            android:orientation="vertical" android:gravity="center" android:layout_marginStart="2dp" android:layout_marginEnd="2dp" android:paddingTop="2dp" android:paddingBottom="4dp">
            <TextView android:id="@+id/p_l1" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#0F2A23" android:textSize="13sp" android:textStyle="bold" android:maxLines="1"/>
            <TextView android:id="@+id/p_n1" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#C9D8D3" android:textSize="19sp" android:maxLines="1"
                android:autoSizeTextType="uniform" android:autoSizeMinTextSize="13sp" android:autoSizeMaxTextSize="21sp"/>
            <TextView android:id="@+id/p_t1" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#EEF3EF" android:textSize="21sp" android:textStyle="bold" android:maxLines="1"
                android:autoSizeTextType="uniform" android:autoSizeMinTextSize="14sp" android:autoSizeMaxTextSize="23sp"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/p_c2" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
            android:orientation="vertical" android:gravity="center" android:layout_marginStart="2dp" android:layout_marginEnd="2dp" android:paddingTop="2dp" android:paddingBottom="4dp">
            <TextView android:id="@+id/p_l2" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#0F2A23" android:textSize="13sp" android:textStyle="bold" android:maxLines="1"/>
            <TextView android:id="@+id/p_n2" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#C9D8D3" android:textSize="19sp" android:maxLines="1"
                android:autoSizeTextType="uniform" android:autoSizeMinTextSize="13sp" android:autoSizeMaxTextSize="21sp"/>
            <TextView android:id="@+id/p_t2" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#EEF3EF" android:textSize="21sp" android:textStyle="bold" android:maxLines="1"
                android:autoSizeTextType="uniform" android:autoSizeMinTextSize="14sp" android:autoSizeMaxTextSize="23sp"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/p_c3" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
            android:orientation="vertical" android:gravity="center" android:layout_marginStart="2dp" android:layout_marginEnd="2dp" android:paddingTop="2dp" android:paddingBottom="4dp">
            <TextView android:id="@+id/p_l3" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#0F2A23" android:textSize="13sp" android:textStyle="bold" android:maxLines="1"/>
            <TextView android:id="@+id/p_n3" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#C9D8D3" android:textSize="19sp" android:maxLines="1"
                android:autoSizeTextType="uniform" android:autoSizeMinTextSize="13sp" android:autoSizeMaxTextSize="21sp"/>
            <TextView android:id="@+id/p_t3" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#EEF3EF" android:textSize="21sp" android:textStyle="bold" android:maxLines="1"
                android:autoSizeTextType="uniform" android:autoSizeMinTextSize="14sp" android:autoSizeMaxTextSize="23sp"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/p_c4" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
            android:orientation="vertical" android:gravity="center" android:layout_marginStart="2dp" android:layout_marginEnd="2dp" android:paddingTop="2dp" android:paddingBottom="4dp">
            <TextView android:id="@+id/p_l4" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#0F2A23" android:textSize="13sp" android:textStyle="bold" android:maxLines="1"/>
            <TextView android:id="@+id/p_n4" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#C9D8D3" android:textSize="19sp" android:maxLines="1"
                android:autoSizeTextType="uniform" android:autoSizeMinTextSize="13sp" android:autoSizeMaxTextSize="21sp"/>
            <TextView android:id="@+id/p_t4" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#EEF3EF" android:textSize="21sp" android:textStyle="bold" android:maxLines="1"
                android:autoSizeTextType="uniform" android:autoSizeMinTextSize="14sp" android:autoSizeMaxTextSize="23sp"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
